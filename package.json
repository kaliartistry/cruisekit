{
  "name": "cruisekit",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "functions:lint": "pnpm --filter cruisekit-functions lint",
    "clean": "turbo clean",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run firestore.rules.test.ts\"",
    "schema:gen:ts": "quicktype --src-lang schema --lang ts --top-level Sailing --just-types data/schema/sailing.schema.json -o shared/models/ts/sailing.ts && quicktype --src-lang schema --lang ts --top-level Deal --just-types data/schema/deal.schema.json -o shared/models/ts/deal.ts && node scripts/postprocess-ts-models.mjs",
    "schema:gen:dart": "quicktype --src-lang schema --lang dart --top-level Sailing --use-freezed data/schema/sailing.schema.json -o shared/models/dart/lib/sailing.dart && quicktype --src-lang schema --lang dart --top-level Deal --use-freezed data/schema/deal.schema.json -o shared/models/dart/lib/deal.dart",
    "schema:gen": "pnpm run schema:gen:ts && pnpm run schema:gen:dart",
    "schema:validate": "node scripts/validate-seed-records.mjs",
    "data:build": "node scripts/build-data-bundles.mjs",
    "data:refresh:viator": "node scripts/update-viator-products.mjs",
    "data:ingest:carnival": "node scripts/ingest/carnival.mjs",
    "data:ingest:azamara": "node scripts/ingest/azamara.mjs",
    "data:ingest:holland-america": "node scripts/ingest/holland-america.mjs",
    "data:ingest:msc": "node scripts/ingest/msc.mjs",
    "data:ingest:norwegian": "node scripts/ingest/norwegian.mjs",
    "data:ingest:princess": "node scripts/ingest/princess.mjs",
    "data:ingest:royal-caribbean": "node scripts/ingest/royal-caribbean.mjs",
    "data:ingest:viking": "node scripts/ingest/viking.mjs",
    "data:ingest:virgin-voyages": "node scripts/ingest/virgin-voyages.mjs",
    "data:review:carnival": "node scripts/review-carnival-staging.mjs",
    "data:review:azamara": "node scripts/review-official-source-staging.mjs --provider azamara",
    "data:review:holland-america": "node scripts/review-official-source-staging.mjs --provider holland-america",
    "data:review:norwegian": "node scripts/review-norwegian-staging.mjs",
    "data:review:princess": "node scripts/review-princess-staging.mjs",
    "data:review:virgin-voyages": "node scripts/review-virgin-voyages-staging.mjs",
    "data:promote:carnival": "node scripts/promote-carnival-staging.mjs",
    "data:promote:azamara": "node scripts/promote-official-source-staging.mjs --provider azamara",
    "data:promote:holland-america": "node scripts/promote-official-source-staging.mjs --provider holland-america",
    "data:promote:norwegian": "node scripts/promote-norwegian-staging.mjs",
    "data:promote:starter-batch": "node scripts/promote-starter-batch.mjs",
    "data:promote:virgin-voyages": "node scripts/promote-virgin-voyages-staging.mjs",
    "data:normalize:regions": "node scripts/normalize-regional-seed-records.mjs",
    "data:finalize:reviewed-refresh": "node scripts/finalize-reviewed-data-refresh.mjs",
    "data:audit:links": "node scripts/audit-public-links.mjs",
    "data:audit:images": "node scripts/audit-bundle-images.mjs",
    "data:freshness": "node scripts/data-freshness-report.mjs",
    "data:review:manual": "node scripts/generate-manual-review-queue.mjs",
    "data:coverage": "node scripts/cruise-line-coverage-report.mjs",
    "data:ingest:weekly-report": "node scripts/run-weekly-ingest-report.mjs",
    "data:report": "pnpm run data:build && node scripts/data-quality-report.mjs && pnpm run data:freshness && pnpm run data:audit:links && pnpm run data:audit:images",
    "data:automation:daily": "node scripts/run-daily-data-automation.mjs",
    "data:automation:monthly": "pnpm run data:coverage",
    "data:publish": "pnpm run data:report && node scripts/publish-data-bundles.mjs",
    "data:publish:candidate": "node scripts/run-publish-candidate.mjs",
    "site:readiness": "node scripts/run-launch-readiness-report.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "firebase": "^12.11.0",
    "firebase-tools": "^13.29.1",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "quicktype": "^23.2.6",
    "turbo": "^2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.33.0"
}
