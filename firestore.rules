rules_version = '2';

// CruiseKit Firestore security rules.
// Covers both the Next.js web app (users, savedDeals) and the Flutter mobile
// app (groups + subcollections). Default deny at the bottom.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds;
    }

    function isGroupOrganizer(groupId) {
      return isSignedIn()
        && request.auth.uid ==
             get(/databases/$(database)/documents/groups/$(groupId)).data.organizerId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function validOptionalLeadString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function validAdminLeadStatus() {
      return request.resource.data.status in [
        'new',
        'email_sent',
        'email_failed',
        'contacted',
        'booked',
        'lost',
        'archived'
      ];
    }

    function validAdminLeadTimestamp(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data[field] == request.time;
    }

    function validAdminLeadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'internalNote',
          'updatedAt',
          'updatedBy',
          'contactedAt',
          'bookedAt',
          'lostAt',
          'archivedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAdminLeadStatus()
        && validOptionalLeadString('internalNote', 2000)
        && validAdminLeadTimestamp('contactedAt')
        && validAdminLeadTimestamp('bookedAt')
        && validAdminLeadTimestamp('lostAt')
        && validAdminLeadTimestamp('archivedAt');
    }

    function validOptionalString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function validOptionalSavedCruiseTimestamp(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] is timestamp
        || request.resource.data[field] is string;
    }

    function validSavedCruise() {
      return request.resource.data.keys().hasOnly([
          'source', 'version', 'sailing', 'confirmedItinerary',
          'cabinNumber', 'cabinType', 'confirmedAt', 'calculatorSnapshot',
          'attribution', 'importState', 'updatedAt'
        ])
        && request.resource.data.sailing is map
        && request.resource.data.confirmedItinerary is list
        && request.resource.data.confirmedItinerary.size() <= 60
        && request.resource.data.sailing.id is string
        && request.resource.data.sailing.id.size() <= 160
        && request.resource.data.sailing.cruiseLineId is string
        && request.resource.data.sailing.cruiseLineId.size() <= 80
        && request.resource.data.sailing.shipName is string
        && request.resource.data.sailing.shipName.size() <= 120
        && request.resource.data.sailing.departureDate is string
        && request.resource.data.sailing.returnDate is string
        && request.resource.data.sailing.duration is number
        && request.resource.data.sailing.departurePort is string
        && request.resource.data.sailing.region is string
        && request.resource.data.sailing.itinerary is list
        && request.resource.data.sailing.itinerary.size() <= 60
        && validOptionalString('source', 40)
        && validOptionalString('version', 40)
        && validOptionalString('cabinNumber', 40)
        && validOptionalString('cabinType', 80)
        && validOptionalSavedCruiseTimestamp('confirmedAt')
        && (!request.resource.data.keys().hasAny(['calculatorSnapshot'])
          || (request.resource.data.calculatorSnapshot is map
            && request.resource.data.calculatorSnapshot.keys().hasOnly([
              'version', 'travelers', 'cabinType', 'duration', 'region',
              'selectedAddOns', 'estimate'
            ])
            && request.resource.data.calculatorSnapshot.version == '1'
            && request.resource.data.calculatorSnapshot.travelers is map
            && request.resource.data.calculatorSnapshot.selectedAddOns is list
            && request.resource.data.calculatorSnapshot.selectedAddOns.size() <= 12
            && request.resource.data.calculatorSnapshot.estimate is map))
        && (!request.resource.data.keys().hasAny(['attribution'])
          || (request.resource.data.attribution is map
            && request.resource.data.attribution.keys().hasOnly([
              'firstTouch', 'convertingTouch'
            ])
            && request.resource.data.attribution.firstTouch is map
            && request.resource.data.attribution.convertingTouch is map))
        && (!request.resource.data.keys().hasAny(['importState'])
          || request.resource.data.importState in ['saved', 'opened', 'imported'])
        && validOptionalSavedCruiseTimestamp('updatedAt');
    }

    // ───── adminUsers/{uid} (ops access gate) ─────
    //
    // Membership is managed through trusted Admin SDK / console operations.
    // Client code can only confirm its own admin marker exists.
    match /adminUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ───── users/{uid} (web) ─────
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
            ['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email is string;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['displayName', 'email', 'photoURL', 'lastLoginAt']);

      // User-deletion goes through the Admin SDK-backed deleteUserAccount callable.
      allow delete: if false;

      match /savedDeals/{dealId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.savedAt is string
          && request.resource.data.fromPrice is number
          && request.resource.data.size() < 30;
      }

      match /savedCruises/{cruiseId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && cruiseId == 'active'
          && validSavedCruise();
      }
    }

    // ───── groups/{groupId} (Flutter MyCrew) ─────
    //
    // Compatibility window: the new app resolves invites through the
    // authenticated callable, but the currently public older build still
    // performs a direct signed-in query. Tighten this to member-only reads
    // after the compatible release is public and adoption is sufficient.
    match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.organizerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUserIds
        && request.resource.data.inviteCode is string;

      allow update: if isSignedIn() && (
        // Organizer: can modify group fields except identity / invite code.
        (resource.data.organizerId == request.auth.uid
          && request.auth.uid in request.resource.data.memberUserIds
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUserIds', 'members', 'name',
                         'cruiseLineId', 'shipName', 'departureDate']))
        ||
        // Self-join: exactly one element added to memberUserIds, and it's me.
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUserIds', 'members'])
          && request.resource.data.memberUserIds.size() ==
               resource.data.memberUserIds.size() + 1
          && request.resource.data.memberUserIds.hasAll(
               resource.data.memberUserIds)
          && request.auth.uid in request.resource.data.memberUserIds
          && !(request.auth.uid in resource.data.memberUserIds)
          && request.resource.data.members.size() ==
               resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members[
               request.resource.data.members.size() - 1].userId == request.auth.uid
          && request.resource.data.members[
               request.resource.data.members.size() - 1].role == 'member')
        ||
        // Self-leave: exactly one element removed from memberUserIds, and it's me.
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUserIds', 'members'])
          && resource.data.organizerId != request.auth.uid
          && request.resource.data.memberUserIds.size() ==
               resource.data.memberUserIds.size() - 1
          && resource.data.memberUserIds.hasAll(
               request.resource.data.memberUserIds)
          && !(request.auth.uid in request.resource.data.memberUserIds)
          && request.auth.uid in resource.data.memberUserIds
          && request.resource.data.members.size() ==
               resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members))
      );

      // Client deletes remain denied; account deletion uses the Admin SDK.
      allow delete: if false;

      match /locations/{userId} {
        allow read: if isGroupMember(groupId);

        allow create, update: if isOwner(userId) && isGroupMember(groupId);

        // Self-leave (user deletes own location) or organizer kick.
        allow delete: if isOwner(userId) || isGroupOrganizer(groupId);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() < 5000;

        // Messages are append-only.
        allow update, delete: if false;
      }
    }

    // ───── dealLeadRequests/{requestId} (retired historical queue) ─────
    //
    // The personal deal-help offer was retired on 2026-07-14. Preserve admin
    // access to historical records, but deny every new client submission.
    match /dealLeadRequests/{requestId} {
      allow create: if false;

      allow read: if isAdmin();
      allow update: if isAdmin() && validAdminLeadUpdate();
      allow delete: if false;
    }

    // ───── default deny ─────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
