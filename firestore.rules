rules_version = '2';

// CruiseKit Firestore security rules.
// Covers both the Next.js web app (users, savedDeals) and the Flutter mobile
// app (groups + subcollections). Default deny at the bottom.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds;
    }

    function isGroupOrganizer(groupId) {
      return isSignedIn()
        && request.auth.uid ==
             get(/databases/$(database)/documents/groups/$(groupId)).data.organizerId;
    }

    function validLeadString(field, maxLength) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLength;
    }

    function validLeadEmail() {
      return request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() >= 6
        && request.resource.data.contactEmail.size() <= 320
        && request.resource.data.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$');
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function validOptionalLeadString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function validOptionalActiveCruiseString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function validOptionalSailingString(field, maxLength) {
      return !request.resource.data.sailing.keys().hasAny([field])
        || (request.resource.data.sailing[field] is string
          && request.resource.data.sailing[field].size() <= maxLength);
    }

    function validSyncedSailing() {
      return request.resource.data.sailing is map
        && request.resource.data.sailing.keys().hasOnly([
          'id',
          'cruiseLineId',
          'shipName',
          'shipId',
          'departureDate',
          'returnDate',
          'duration',
          'departurePort',
          'region',
          'itinerary'
        ])
        && request.resource.data.sailing.keys().hasAll([
          'id',
          'cruiseLineId',
          'shipName',
          'departureDate',
          'returnDate',
          'duration',
          'departurePort',
          'region',
          'itinerary'
        ])
        && request.resource.data.sailing.id is string
        && request.resource.data.sailing.id.size() <= 160
        && request.resource.data.sailing.cruiseLineId is string
        && request.resource.data.sailing.cruiseLineId.size() <= 80
        && request.resource.data.sailing.shipName is string
        && request.resource.data.sailing.shipName.size() <= 160
        && validOptionalSailingString('shipId', 160)
        && request.resource.data.sailing.departureDate is string
        && request.resource.data.sailing.departureDate.size() <= 10
        && request.resource.data.sailing.returnDate is string
        && request.resource.data.sailing.returnDate.size() <= 10
        && request.resource.data.sailing.duration is number
        && request.resource.data.sailing.duration >= 1
        && request.resource.data.sailing.duration <= 365
        && request.resource.data.sailing.departurePort is string
        && request.resource.data.sailing.departurePort.size() <= 160
        && request.resource.data.sailing.region is string
        && request.resource.data.sailing.region.size() <= 80
        && request.resource.data.sailing.itinerary is list
        && request.resource.data.sailing.itinerary.size() <= 60;
    }

    function validActiveCruiseDocument() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.status in ['active', 'deleted']
        && request.resource.data.sourcePlatform in ['web', 'ios', 'android']
        && (
          (
            request.resource.data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'status',
              'sourcePlatform',
              'createdAt',
              'updatedAt',
              'sailing',
              'confirmedItinerary',
              'confirmedAt',
              'itineraryTitle',
              'imageUrl',
              'sourceUrl'
            ])
            && request.resource.data.keys().hasAll([
              'schemaVersion',
              'status',
              'sourcePlatform',
              'createdAt',
              'updatedAt',
              'sailing',
              'confirmedItinerary'
            ])
            && validSyncedSailing()
            && request.resource.data.confirmedItinerary is list
            && request.resource.data.confirmedItinerary.size() <= 60
            && validOptionalActiveCruiseString('confirmedAt', 40)
            && validOptionalActiveCruiseString('itineraryTitle', 240)
            && validOptionalActiveCruiseString('imageUrl', 2000)
            && validOptionalActiveCruiseString('sourceUrl', 2000)
          )
          ||
          (
            request.resource.data.status == 'deleted'
            && request.resource.data.keys().hasOnly([
              'schemaVersion',
              'status',
              'sourcePlatform',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'schemaVersion',
              'status',
              'sourcePlatform',
              'createdAt',
              'updatedAt'
            ])
          )
        );
    }

    function validActiveCruiseCreate() {
      return validActiveCruiseDocument()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validActiveCruiseUpdate() {
      return validActiveCruiseDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminLeadStatus() {
      return request.resource.data.status in [
        'new',
        'email_sent',
        'email_failed',
        'contacted',
        'booked',
        'lost',
        'archived'
      ];
    }

    function validAdminLeadTimestamp(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || request.resource.data[field] == request.time;
    }

    function validAdminLeadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'internalNote',
          'updatedAt',
          'updatedBy',
          'contactedAt',
          'bookedAt',
          'lostAt',
          'archivedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && validAdminLeadStatus()
        && validOptionalLeadString('internalNote', 2000)
        && validAdminLeadTimestamp('contactedAt')
        && validAdminLeadTimestamp('bookedAt')
        && validAdminLeadTimestamp('lostAt')
        && validAdminLeadTimestamp('archivedAt');
    }

    // ───── adminUsers/{uid} (ops access gate) ─────
    //
    // Membership is managed through trusted Admin SDK / console operations.
    // Client code can only confirm its own admin marker exists.
    match /adminUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ───── users/{uid} (web) ─────
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
            ['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email is string;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['displayName', 'email', 'photoURL', 'lastLoginAt']);

      // User-deletion goes through an Admin SDK path (not yet built).
      allow delete: if false;

      match /savedDeals/{dealId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.savedAt is string
          && request.resource.data.fromPrice is number
          && request.resource.data.size() < 30;
      }

      match /activeCruise/{cruiseDocId} {
        allow read: if cruiseDocId == 'current' && isOwner(uid);
        allow create: if cruiseDocId == 'current'
          && isOwner(uid)
          && validActiveCruiseCreate();
        allow update: if cruiseDocId == 'current'
          && isOwner(uid)
          && validActiveCruiseUpdate();
        allow delete: if false;
      }
    }

    // ───── groups/{groupId} (Flutter MyCrew) ─────
    //
    // Reads are allowed for any signed-in user. The join flow needs to look up
    // a group by inviteCode before the user is a member; member-only reads
    // would break that. Group IDs are auto-generated 20-char strings and
    // invite codes are 6-char from a 32-char alphabet, so direct enumeration
    // is impractical. Subcollections (locations, messages) require membership.
    // Long-term fix: move invite lookup to a separate `groupInvites/{code}`
    // collection or a Cloud Function and tighten this read rule.
    match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.organizerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUserIds
        && request.resource.data.inviteCode is string;

      allow update: if isSignedIn() && (
        // Organizer: can modify group fields except identity / invite code.
        (resource.data.organizerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUserIds', 'members', 'name',
                         'cruiseLineId', 'shipName', 'departureDate']))
        ||
        // Self-join: exactly one element added to memberUserIds, and it's me.
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUserIds', 'members'])
          && request.resource.data.memberUserIds.size() ==
               resource.data.memberUserIds.size() + 1
          && request.auth.uid in request.resource.data.memberUserIds
          && !(request.auth.uid in resource.data.memberUserIds))
        ||
        // Self-leave: exactly one element removed from memberUserIds, and it's me.
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUserIds', 'members'])
          && request.resource.data.memberUserIds.size() ==
               resource.data.memberUserIds.size() - 1
          && !(request.auth.uid in request.resource.data.memberUserIds)
          && request.auth.uid in resource.data.memberUserIds)
      );

      // No delete flow exists in the Flutter code.
      allow delete: if false;

      match /locations/{userId} {
        allow read: if isGroupMember(groupId);

        allow create, update: if isOwner(userId) && isGroupMember(groupId);

        // Self-leave (user deletes own location) or organizer kick.
        allow delete: if isOwner(userId) || isGroupOrganizer(groupId);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() < 5000;

        // Messages are append-only.
        allow update, delete: if false;
      }
    }

    // ───── dealLeadRequests/{requestId} (Flutter deal handoff) ─────
    //
    // Mobile clients can create lead requests. Only explicit admins can read
    // or update the operational queue, and they cannot change customer/deal
    // source fields captured at submission time.
    match /dealLeadRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'status',
          'sourcePlatform',
          'sourceSurface',
          'requesterUid',
          'requesterIsAnonymous',
          'contactName',
          'contactEmail',
          'contactPhone',
          'note',
          'dealId',
          'cruiseLineId',
          'cruiseLine',
          'shipName',
          'itineraryTitle',
          'departureDate',
          'fromPrice',
          'currency',
          'lastVerified',
          'bookingUrl'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'status',
          'sourcePlatform',
          'sourceSurface',
          'requesterUid',
          'requesterIsAnonymous',
          'contactName',
          'contactEmail',
          'contactPhone',
          'note',
          'dealId',
          'cruiseLineId',
          'cruiseLine',
          'shipName',
          'itineraryTitle',
          'departureDate',
          'fromPrice',
          'currency',
          'lastVerified',
          'bookingUrl'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterIsAnonymous is bool
        && request.resource.data.fromPrice is number
        && validLeadString('sourcePlatform', 32)
        && validLeadString('sourceSurface', 64)
        && validLeadString('contactName', 120)
        && validLeadEmail()
        && validLeadString('contactPhone', 40)
        && validLeadString('note', 2000)
        && validLeadString('dealId', 160)
        && validLeadString('cruiseLineId', 80)
        && validLeadString('cruiseLine', 120)
        && validLeadString('shipName', 160)
        && validLeadString('itineraryTitle', 240)
        && validLeadString('departureDate', 32)
        && validLeadString('currency', 8)
        && validLeadString('lastVerified', 32)
        && validLeadString('bookingUrl', 2048);

      allow read: if isAdmin();
      allow update: if isAdmin() && validAdminLeadUpdate();
      allow delete: if false;
    }

    // ───── default deny ─────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
